# CivicX Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/civicx?replicaSet=rs0
LOG_LEVEL=debug

# AI adapter (stub for now)
AI_PROVIDER=mock
# AI_API_KEY=  ← set in .env, never here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

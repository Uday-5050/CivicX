# CivicX Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/civicx
LOG_LEVEL=debug

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# AI classification. Gemini credentials stay in this backend file only.
# Keep `rules` while no key is available; use `gemini` after adding a valid key.
AI_PROVIDER=rules
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=12000
AI_MAX_INPUT_CHARS=6000
AI_WORKER_ENABLED=true
AI_WORKER_POLL_MS=2000
AI_MAX_ATTEMPTS=3
AI_LEASE_MS=30000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Cloudinary media storage (keep the real values only in .env)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
